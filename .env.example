# Personal access token with repo (and security_events for private repos) scope
GITHUB_TOKEN=

# Org or user login whose repos should be checked
GITHUB_ORG=EbrightOD

# Email alerts (sent only when a repo status is FAIL) — matches Ebright_OSC_V2's
# existing Gmail-SMTP convention: send from and alert od@ebright.my
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=od@ebright.my
SMTP_PASS=
ALERT_EMAIL_TO=od@ebright.my

# Telegram alerts (sent only when a repo status is FAIL) — get these from
# @BotFather (bot token) and https://api.telegram.org/bot<TOKEN>/getUpdates (chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
